{
  "S00678": "快出去吧！",
  "S00688": "祝你在外面好運！",
  "S00690": "你好，很高興見到你！",
  "S00691": "嘿，我只是——",
  "S00692": "聊得真愉快！",
  "S00698": "忙得沒空說話",
  "S00699": "似乎有心事……",
  "S00708": "    這才像話。",
  "S00723": "嗯……那倒不錯。",
  "S00733": "赤龍",
  "S00741": "我又沒說有……",
  "S00744": "遵命，女士",
  "S00745": "遵命，女士。",
  "S00754": "呃……啊？",
  "S00755": "等一下，為什麼？",
  "S00757": "是，女士……",
  "S00770": "維妮塔？",
  "S00771": "維妮塔？",
  "S00773": "可我為什麼會在這裡？",
  "S00775": "當然，嘿嘿。",
  "S00787": "下次再加油吧！",
  "S00788": "所以我輸了。",
  "S00796": "是，女士。",
  "S00799": "我……懂了。",
  "S00812": "好啦好啦，我懂了。",
  "S00815": "哈！我聽到了。",
  "S00816": "天啊！",
  "S00819": "糟了。",
  "S00822": "我大概能想像。",
  "S00828": "替他倒了一杯新鮮的黑啤，酒沫幾乎溢出杯緣。",
  "S00829": "大口喝啤酒",
  "S00870": "嗯……到時再說。",
  "S00905": "好啊，何樂而不為！",
  "S00915": "跟你給狗頭人的東西差不多，只是來源不同。這玩意兒後勁十足，簡直能把人一腳踢飛——畢竟是馬嘛。好啦，就是馬的精液。",
  "S00920": "說到這個，讓我想起一個故事——",
  "S00923": "我老爸——願他那又胖又醉的靈魂安息——常跟我說：『別去打聽香腸怎麼做的。』當然，他說這話時多半醉得口齒不清，而且通常正把手伸進豬肚子裡，忙著做香腸。我想他只是覺得，一邊拆解動物一邊講這句很有趣；不過這話也不是全無道理。難得他說出一句有智慧的話，總得記上一筆。",
  "S00957": "嗯，本來就是。",
  "S00966": "給我一個更好的",
  "S01008": "\t你能嗎？"
}
