"Map001.rxdata/@events/15/@pages/0/@list/33/code101/p0"	"LAURA:"
"Map001.rxdata/@events/15/@pages/0/@list/34/code401/p0"	"What do you mean?"
"Map001.rxdata/@events/15/@pages/0/@list/35/code401/p0"	"I fit their criteria-"
"Map001.rxdata/@events/15/@pages/0/@list/66/code401/p0"	"But it's her, I'm sure!"
"Map001.rxdata/@events/15/@pages/0/@list/166/code401/p0"	"She'll be alone in her apartment."
"Map001.rxdata/@events/15/@pages/0/@list/233/code102/p0/1"	"Go with Laura"
"Map001.rxdata/@events/15/@pages/0/@list/233/code102/p0/2"	"Go with Sandy"
"Map001.rxdata/@events/15/@pages/0/@list/233/code102/p0/3"	"Go with Cindy"
"Map001.rxdata/@events/15/@pages/0/@list/237/code402/p1"	"Go with Laura"
"Map001.rxdata/@events/15/@pages/0/@list/303/code401/p0"	"Who will be driving my car?"
"Map001.rxdata/@events/15/@pages/0/@list/324/code401/p0"	"Stop acting like a spoiled child!"
"Map001.rxdata/@events/15/@pages/0/@list/334/code355/p0"	"Achievements.unlock(:FW1)"
"Map001.rxdata/@events/15/@pages/0/@list/351/code102/p0/1"	"Better sorry than safe"
"Map001.rxdata/@events/15/@pages/0/@list/351/code102/p0/2"	"Laura just shut up"
"Map001.rxdata/@events/15/@pages/0/@list/355/code402/p1"	"Better sorry than safe"
"Map001.rxdata/@events/15/@pages/0/@list/359/code402/p1"	"Laura just shut up"
"Map001.rxdata/@events/15/@pages/0/@list/366/code402/p1"	"Go with Sandy"
"Map001.rxdata/@events/15/@pages/0/@list/382/code401/p0"	"But first we need Sandy's car."
"Map001.rxdata/@events/15/@pages/0/@list/384/code401/p0"	"How do we get in your apartment?"
"Map001.rxdata/@events/15/@pages/0/@list/410/code355/p0"	"Achievements.unlock(:FW1)"
"Map001.rxdata/@events/15/@pages/0/@list/427/code102/p0/1"	"Snickers, Mars"
"Map001.rxdata/@events/15/@pages/0/@list/427/code102/p0/2"	"Coca-Cola"
