arameters":["find a way to release Ganga. Our Goddess Thora"]},{"code":401,"indent":0,"parameters":["has tried all she could to avoid that but unfortunately"]},{"code":101,"indent":0,"parameters":["faces",4,0,2]},{"code":401,"indent":0,"parameters":["Luz:"]},{"code":401,"indent":0,"parameters":["she was unable to. Ganga is being released,"]},{"code":401,"indent":0,"parameters":["that is a reality. You are not to stop that."]},{"code":401,"indent":0,"parameters":["You are to stop him."]},{"code":101,"indent":0,"parameters":["faces",4,0,2]},{"code":401,"indent":0,"parameters":["Luz:"]},{"code":401,"indent":0,"parameters":["His plans are to resume his father's objective,"]},{"code":401,"indent":0,"parameters":["and that is to destroy all humankind and create "]},{"code":401,"indent":0,"parameters":["a new being to rule over."]},{"code":101,"indent":0,"parameters":["faces",4,0,2]},{"code":401,"indent":0,"parameters":["Luz:"]},{"code":401,"indent":0,"parameters":["Thora fought for us once, now it's time we"]},{"code":401,"indent":0,"parameters":["fight for her."]},{"code":230,"indent":0,"parameters":[15]},{"code":101,"indent":0,"parameters":["faces",3,0,2]},{"code":401,"indent":0,"parameters":["Eileen:"]},{"code":401,"indent":0,"parameters":["Why us?"]},{"code":230,"indent":0,"parameters":[15]},{"code":101,"indent":0,"parameters":["faces",4,0,2]},{"code":401,"indent":0,"parameters":["Luz:"]},{"code":401,"indent":0,"parameters":["If Thora chose you then you have something"]},{"code":401,"indent":0,"parameters":["special inside each of you. She believes you"]},{"code":401,"indent":0,"parameters":["are the perfect group for this mission, we shouldn't"]},{"code":101,"indent":0,"parameters":["faces",4,0,2]},{"code":401,"indent":0,"parameters":["Luz:"]},{"code":401,"indent":0,"parameters":["doubt her judgement."]},{"code":230,"indent":0,"parameters":[15]},{"code":101,"indent":0,"parameters":["faces",0,0,2]},{"code":401,"indent":0,"parameters":["Vaynard:"]},{"code":401,"indent"